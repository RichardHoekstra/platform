<?wh

/* direct test links: https://my.webhare.dev/?app=wrd(system:usermgmt)/oidcproviders
*/

LOADLIB "wh::datetime.whlib";

LOADLIB "mod::system/lib/configure.whlib";
LOADLIB "mod::system/lib/services.whlib";
LOADLIB "mod::system/lib/webapi/oauth2.whlib";

LOADLIB "mod::tollium/lib/screenbase.whlib";

LOADLIB "mod::wrd/lib/screenbase.whlib";
LOADLIB "mod::wrd/lib/internal/auth/oidc.whlib";
LOADLIB "mod::wrd/lib/internal/auth/support.whlib";

PUBLIC STATIC OBJECTTYPE Providers EXTEND TolliumScreenBase <
  MACRO Init(RECORD data) {
    ^providers->embeddedlist->rowiconname := "idpicon";
    ^providers->entitycontext := CELL[ is_idp := TRUE ];
  }

  RECORD ARRAY FUNCTION MapProviders(RECORD ARRAY rows) {
    RETURN SELECT *, idpicon := ^providers->embeddedlist->GetIcon(GuessOpenIdIcon(metadata_url).tollium)  FROM rows;
  }

  INTEGER FUNCTION OnEditProvider(OBJECT wrdtype, RECORD context, INTEGER entityid) {
    // IF(entityid = 0) {
    //   RETURN this->RunScreen("#addprovider"); //ADDME should probably pass the requested scopes
    // }
    RETURN ^providers->RunEntityEditScreen("#editprovider", entityid) ?? entityid;
  }

  MACRO DoTestProvider() {
    this->RunScreen("#testprovider", CELL [ provider := ^providers->selection.rowkey ]);
  }
>;

PUBLIC STATIC OBJECTTYPE EditProvider EXTEND WRDEntityEditScreenBase <
  STRING initial_clientsecret;

  UPDATE MACRO Init(RECORD data) {
    ^entity->^redirect_uri->options :=
      [[ title := GetDefaultOauth2RedirectURL() ]
      ];

    WRDEntityEditScreenBase::Init(data);

    IF(data.id != 0) {
      RECORD signing := ^entity->wrdtype->GetEntityFields(data.id, [ "client_signing" ]).client_signing;
      IF(RecordExists(signing) AND signing.type = "client_secret")
        this->initial_clientsecret := signing.secret;
      ELSE IF(RecordExists(signing)) {
        ^clientsecret->enabled := FALSE;
        ^showclientsecret->enabled := FALSE;
      }
    }
    ^clientsecret->value := this->initial_clientsecret;

    IF(^entity->^redirect_uri->value = "")
      ^entity->^redirect_uri->value := GetDefaultOauth2RedirectURL();

    ^entity->^login_field->required := ^entity->^login_field->value != ""; //should never go empty again!
  }

  UPDATE RECORD FUNCTION Submitter(OBJECT work, RECORD updatevalue) {
    IF(^clientsecret->enabled AND ^clientsecret->value != this->initial_clientsecret)
      updatevalue := CELL[ ...updatevalue, client_signing := ^clientsecret->value != "" ? CELL[ type := "client_secret", secret := ^clientsecret->value ] : DEFAULT RECORD ];
    RETURN updatevalue;
  }

  MACRO OnOpenMetadataURL(OBJECT browser) {
    browser->SendURL(^entity->^metadata_url->value);
  }

  MACRO OnReveal() {
    ^clientsecret->password := NOT ^showclientsecret->value;
  }
>;

PUBLIC STATIC OBJECTTYPE TestProvider EXTEND TolliumScreenBase <
  RECORD data;

  MACRO Init(RECORD data) {
    this->data := data;
  }
  MACRO DoTestLogin(OBJECT browser) {
    //I'm not sure if there's a practical risk if users do tricks with the debug URL but just in case we'll make sure the debug logins have limited availability
    STRING debugpage := GetPrimaryWebhareInterfaceURL() || ".wh/auth/debuglogin?debug=" || EncryptForThisServer("platform:debuglogin", CELL [ now := GetCurrentDateTime() ]);
    browser->SendURL(CreateOAuth2LoginRequest(this->contexts->wrdschema->tag, "#" || this->data.provider, debugpage,
      [ raw_landing := TRUE
      , prompt := ^prompt->value
      ]).url);
  }
>;
