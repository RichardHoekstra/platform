// By default, show version events within the last 30 days
INTEGER default_history_range := 365;

INTEGER64 FUNCTION VersionToLong(STRING version) {
  STRING ARRAY toks := Tokenize(version, ".");
  IF(Length(toks)=2)
    RETURN ToInteger(toks[0], 0) * 100000 + ToInteger(toks[1], 0);
  ELSE
    RETURN 0;
}

RECORD FUNCTION GetHistoryTypes(OBJECT list) {
  RECORD historytypes := [
    recycled :=             [ title := GetTid("publisher:tolliumapps.filemanager.history.dialog.event-recycled"), icon := list->GetIcon("tollium:actions/trash") ],
    saved :=                [ title := GetTid("publisher:tolliumapps.filemanager.history.dialog.event-saved"), icon := list->GetIcon("tollium:actions/save") ],
    "abandoned-autosave" := [ title := GetTid("publisher:tolliumapps.filemanager.history.dialog.event-abandoned-autosave"), icon := list->GetIcon("tollium:actions/cancel") ],
    "abandoned-draft" :=    [ title := GetTid("publisher:tolliumapps.filemanager.history.dialog.event-abandoned-draft"), icon := list->GetIcon("tollium:actions/cancel") ],
    created :=              [ title := GetTid("publisher:tolliumapps.filemanager.history.dialog.event-created"), icon := list->GetIcon("tollium:status/new") ],
    approved :=             [ title := GetTid("publisher:tolliumapps.filemanager.history.dialog.event-approved"), icon := list->GetIcon("tollium:status/checked") ],
    autosave :=             [ title := GetTid("publisher:tolliumapps.filemanager.history.dialog.event-autosave"), icon := list->GetIcon("tollium:actions/save+tollium:overlays/filetypes/clock") ],
    import :=               [ title := GetTid("publisher:tolliumapps.filemanager.history.dialog.event-import"), icon := list->GetIcon("tollium:status/new") ],
    final :=                [ title := GetTid("publisher:tolliumapps.filemanager.history.dialog.event-final"), icon := list->GetIcon("tollium:status/checked") ],
  ];
  FOREVERY (STRING type FROM whconstant_historytypes)
    IF(NOT CellExists(historytypes, type))
      THROW NEW Exception("History types mismatch, missing: " || type);
  RETURN historytypes;
}

PUBLIC STATIC OBJECTTYPE History EXTEND PublisherMetadataBase <
  // ---------------------------------------------------------------------------
  //
  // Variables
  //

  //INTEGER siteid;

  OBJECT liveobject;

  OBJECT maintabs;

  RECORD ARRAY extendprops;

  //OBJECT historyextcomp;
  //OBJECT policy;

  //RECORD configdata;

  RECORD historytypes;

  BOOLEAN have_properties;

  // ---------------------------------------------------------------------------
  //
  // Init
  //

  MACRO NEW() : PublisherMetadataBase([mode := "versions"]) {
  }

  MACRO Init(RECORD data) {
    RECORD targetinfo := SELECT id, snapshotfor, isfolder FROM system.fs_objects WHERE id = VAR data.id;
    IF(NOT RecordExists(targetinfo)) {
      this->tolliumresult := "close";
      RETURN;
    }

    this->frame->flags.issysop := this->tolliumuser->HasRight("system:sysop");
    this->frame->flags.issupervisor := this->frame->flags.issysop OR this->tolliumuser->HasRight("system:supervisor");

    this->liveobject := OpenWHFSObject(targetinfo.snapshotfor ?? data.id);
    this->isfolder := targetinfo.isfolder;
    this->frame->title := this->GetTid(".dialogtitle", this->liveobject->name);
    this->contexts->applytester := GetApplyTesterForObject(this->liveobject->id);

    ^include_autosaves->visible := this->frame->flags.issupervisor;

    //enable it if the target item is only visible in autosave rows
    INTEGER ARRAY in_history_types := targetinfo.snapshotfor != 0 ? SELECT AS INTEGER ARRAY DISTINCT type FROM system_internal.fs_history WHERE fs_history.snapshot = data.id AND fs_object = targetinfo.snapshotfor : INTEGER[];
    ^include_autosaves->value := ^include_autosaves->visible AND Length(in_history_types) > 0 AND Length(ArrayDelete(in_history_types, [whconstant_historytype_abandoned_autosave, whconstant_historytype_autosave])) =0;

    ^listener->masks := this->liveobject->GetEventMasks([ "object", "history" ]);

    this->historytypes := GetHistoryTypes(^versions);

    this->RenderMetadataComponents();
    this->ApplyBaseSettings();

    this->Refresh();
    ^versions->SetValueIfValid(data.id);
    IF(targetinfo.snapshotfor != 0) //if we deeplinked to a version, select it
      ^versions->selection := SELECT * FROM ^versions->rows WHERE snapshot = targetinfo.id;
    IF (CellExists(data, "versionid") AND data.versionid != 0)
      ^versions->value := data.versionid;

  }

  MACRO OnFilterChange() {
    this->Refresh();
  }

  // ---------------------------------------------------------------------------
  //
  // Callbacks
  //

  MACRO GotEvents(RECORD ARRAY events) {
    this->Refresh();
  }

  MACRO GotDateRangeChange() {
    this->Refresh();
  }

  // ---------------------------------------------------------------------------
  //
  // List fills
  //

  MACRO Refresh() {
    RECORD ARRAY historyitems := ListObjectHistory(this->liveobject->id, [ include_autosaves := ^include_autosaves->value ]);

    RECORD ARRAY rows :=
        SELECT rowkey :=          id
             , type
             , historytype_icon:= CellExists(this->historytypes, type) ? GetCell(this->historytypes, type).icon : 0
             , historytype :=     CellExists(this->historytypes, type) ? GetCell(this->historytypes, type).title : type
             , when
             , filename :=        "n/a"
             , comment :=         "n/a"
             , displayname :=     (CellExists(userdata, "realname") ? userdata.realname : "") ??
                                  (CellExists(userdata, "login") ? userdata.login : "") ??
                                  (CellExists(userdata, "emailaddress") ? userdata.emailaddress : "") ??
                                  this->GetTid(".unknownuser")
             , versionnumber :=   version
             , versionsort :=     VersionToLong(version)
             , isactive
             , snapshot
             , cancopy :=         snapshot != 0
             , canview :=         snapshot != 0 AND RecordExists(this->renderer->metatabsconfig.workflowEditor)
          FROM historyitems;

    ^versions->rows := rows;
  }

  MACRO LoadBaseData(RECORD sel) {
    OBJECT sourceobject := OpenWHFSObject(sel.snapshot);
    ^metadatacontent->visible := ObjectExists(sourceobject);
    IF(NOT ^metadatacontent->visible)
      RETURN;

    RECORD draftmeta := sourceobject->GetInstanceData("http://www.webhare.net/xmlns/publisher/draftmetadata");

    ^pinobject->value := ObjectExists(sourceobject) AND sourceobject->ispinned;

    ^name->value := draftmeta.name ?? SuggestSeoNameFromTitle(sourceobject->title, CELL[fsobject := sourceobject]);

    FOREVERY (STRING field FROM ["title", "description", "keywords" ])
    {
      OBJECT fieldobj := GetMember(this, "^" || field);
      fieldobj->value := GetMember(sourceobject, field);
    }
  }

  MACRO RenderMetadataComponents() {
    this->renderer := CreateMetatabsRenderer([
      objectid := this->liveobject->id,
      parent := this->liveobject->parent,
      isfolder := this->liveobject->isfolder,
      type := this->liveobject->type,
      mode := "versions"
    ]);

    this->renderer->RegisterMetaController(^webmetadata->type, ^webmetadata, TRUE);

    RECORD ARRAY extendprops;

    INTEGER insertpos := 1;
    IF(RecordExists(this->renderer->metatabsconfig)) {
      FOREVERY(RECORD type FROM this->renderer->metatabsconfig.types) {
        FOREVERY(RECORD section FROM this->renderer->PrepareTypeSections(this->contexts, type)) {
          OBJECT newsection := this->CreateTolliumComponent("section");
          newsection->title := section.title;
          newsection->open := FALSE;

          FOREVERY(RECORD line FROM section.lines) {
            newsection->panel->layout := line.layout;
            newsection->panel->InsertComponentAfter(line.line, DEFAULT OBJECT, TRUE);
          }
          IF (type.workflow)
            ^metadatacontent->InsertComponentAfter(newsection, DEFAULT OBJECT, TRUE);
          ELSE {
            ^properties->InsertComponentAfter(newsection, DEFAULT OBJECT, TRUE);
            this->have_properties := TRUE;
          }

        }
      }
      extendprops := this->renderer->RenderLegacyExtensions(this->contexts, ^metadatacontent, [ propertiescontainer := ^properties ]);
      FOREVERY (RECORD rec FROM extendprops)
        IF (rec.workflow)
          this->have_properties := TRUE;
    }

    //make sure the rest of the UI is initialized. ensure eg. toolbar buttons are visible when asking about restoring draft/autosave or the formeditor would look half-done
    FOREVERY(RECORD extendprop FROM extendprops)
      extendprop.tabs->RunExtensionsPostInit();

    // Disable all metacontrollers so the fields are disabled too
    this->renderer->SetControllersEnabled(FALSE);
  }

  MACRO OnSelectRequest() {
    RECORD sel := ^versions->selection;
    STRING previewlink;
    IF (RecordExists(sel)) {
      ^modifications->rows := RECORD[];//GetModifications(sel.rowkey);

      // Init the preview
      STRING link := GetPreviewLink(sel.snapshot);
      ^previewbrowser->SetPreviewURL(link);

      // Assumption: sel.snapshot is 0 only for the document creation version.
      ^nosnapshot->visible := sel.snapshot = 0;
      ^proptabs->visible := sel.snapshot != 0;

      // Load the data
      this->LoadBaseData(sel);

      RECORD ARRAY instances := ListInstances(sel.snapshot);
      FOREVERY (RECORD controller FROM this->renderer->metacontrollers) {
        // Show all data for final versions, and all workflow items from drafts/autosaves
        BOOLEAN show := sel.type = "final" OR RecordExists(SELECT FROM instances WHERE namespace = controller.type->namespace AND workflow);

        controller.fsinstance->value := controller.type->GetInstanceData(sel.snapshot);
        FOREVERY (OBJECT comp FROM controller.components)
          comp->visible := show;
      }

      this->^properties->visible := sel.type = "final" AND this->have_properties;
    }
    ELSE
    {
      ^previewbrowser->SetPreviewURL("");
      ^nosnapshot->visible := FALSE;
      ^proptabs->visible := TRUE;
      ^modifications->rows := DEFAULT RECORD ARRAY;
      ^metadatacontent->visible := FALSE;
      ^properties->visible := FALSE;
    }
  }

  // ---------------------------------------------------------------------------
  //
  // Actions
  //

  MACRO DoCopy() {
    RunCopyMoveObjects(this, INTEGER[ ^versions->selection.snapshot], "copy", [ suggestdestination := this->liveobject->parent ]);
  }

  MACRO DoInspect() {
    RunFSObjectInspectDialog(this, ^versions->selection.snapshot);
  }

  MACRO DoView() {
    RunFSObjectEditApplication(this, this->liveobject->id, [ showversion := ^versions->value ]);
  }
>;


PUBLIC STATIC OBJECTTYPE VersionOverview EXTEND TolliumScreenBase <

  RECORD historytypes;
  RECORD ARRAY rows;

  MACRO Init() {
    this->historytypes := GetHistoryTypes(^versions);

    ^date_start->value := LocalToUTC(GetRoundedDateTime(AddDaysToDate(-7, UTCToLocal(GetCurrentDateTime(), "CET")), 86400 * 1000), "CET");

    this->ReloadQuery();
  }

  MACRO GotChange() {
    this->ReloadQuery();
  }

  MACRO GotDirty() {
    ^dates_dirty->ClearDirty();
    this->ReloadQuery();
  }

  MACRO GotFilterChange() {
    this->ReloadList();
  }

  MACRO ReloadQuery() {

    RECORD ARRAY historyitems := QueryObjectHistory([
      date_start := ^date_start->value,
      date_limit := ^date_limit->value ?? MAX_DATETIME,
      include_autosaves := ^include_autosaves->value
    ]);

    INTEGER ARRAY fileids := GetSortedSet(SELECT AS INTEGER ARRAY fs_object FROM historyitems);
    RECORD ARRAY files :=
        SELECT fs_object := id
             , whfspath
          FROM system.fs_objects
         WHERE id IN fileids
      ORDER BY id;

    this->rows :=
        SELECT TEMPORARY filepos :=   RecordLowerBound(files, historyitems, [ "FS_OBJECT" ])
             , TEMPORARY file :=      filepos.found ? files[filepos.position] : [ whfspath := "" ]
             , TEMPORARY displayname := (CellExists(userdata, "realname") ? userdata.realname : "") ??
                                      (CellExists(userdata, "login") ? userdata.login : "") ??
                                      (CellExists(userdata, "emailaddress") ? userdata.emailaddress : "") ??
                                      this->GetTid(".unknownuser")
             , rowkey :=              id
             , id
             , fs_object
             , type
             , historytype_icon:=     CellExists(this->historytypes, type) ? GetCell(this->historytypes, type).icon : 0
             , historytype :=         CellExists(this->historytypes, type) ? GetCell(this->historytypes, type).title : type
             , when
             , filename :=            "n/a"
             , comment :=             "n/a"
             , displayname :=         displayname
             , versionnumber :=       version
             , versionsort :=         VersionToLong(version)
             , isactive
             , snapshot
             , whfspath :=            file.whfspath
             , filtertext :=          ToUppercase(`${file.whfspath} ${displayname}`)
          FROM historyitems
         WHERE (^include_recycled->value ? TRUE : type != "recycled")
          ;

    this->ReloadList();
  }

  MACRO ReloadList() {
    STRING ARRAY filtermasks := Tokenize(Substitute("*" || Substitute(TrimWhitespace(NormalizeWhitespace(ToUppercase(^filter->value))), " ", "* *") || "*", "**", "*"), " ");
    ^versions->rows := SELECT * FROM this->rows WHERE __MatchesAllMasks(filtertext, filtermasks);
  }

  MACRO DoOpenInPublisher() {
    RunPublisherFileManager(this, ^versions->selection.fs_object, [ infilelist := TRUE ]);
  }

  MACRO DoOpenInVersions() {
   RunFSObjectVersionsDialog(this, ^versions->selection.fs_object, [ versionid := ^versions->selection.id ]);
  }
>;
